---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import VideoCard from "../components/VideoCard.vue";
import MarkedWord from "../components/MarkedWord.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getPosterUrl } from "../lib/video";
import { byNewestFirst } from "../lib/projects";
import { categoryContent } from "../data/categories";

const cat = categoryContent.find((c) => c.slug === "imagefilme")!;

const all = await getCollection("projects");
const projects = all
	.filter((p: CollectionEntry<"projects">) => p.data.category === "imagefilm")
	.sort(byNewestFirst);

const hero = projects.find((p) => p.data.featured) ?? projects[0];

const gridCards = await Promise.all(
	projects.map(async (p) => ({
		project: p,
		thumbnailUrl: await getPosterUrl(p.data),
	})),
);
---

<BaseLayout
	title="Imagefilme"
	description="Premiumproduktionen: Imagefilme von TRUE FRAME."
	theme="imagefilm"
	footerVariant="category"
>
	<Hero
		videoUrl={hero?.data.videoUrl}
		posterUrlOverride={hero?.data.thumbnail}
		bgClipUrl={hero?.data.bgClip}
		caption="TOP-PROJEKT · VOLLFLÄCHIGES VIDEO"
		scriptLine={cat.scriptLine}
		headline={cat.headline}
		metaLine={
			hero
				? ["IMAGEFILM", hero.data.year, hero.data.duration]
						.filter(Boolean)
						.join(" · ")
				: undefined
		}
		body={cat.body}
	/>

	<section class="mx-auto max-w-6xl px-6 py-16 md:px-10">
		<p class="font-mono text-xs tracking-widest text-ink-muted">
			{projects.length === 1 ? "1 PROJEKT" : `${projects.length} PROJEKTE`}
		</p>
		<div class="mt-8 grid gap-8 md:grid-cols-2">
			{
				gridCards.map(({ project, thumbnailUrl }) => (
					<VideoCard
						client:visible
						title={project.data.title}
						description={project.data.description}
						client={project.data.client}
						meta={project.data.duration}
						thumbnailUrl={thumbnailUrl}
						detailHref={`/imagefilme/${project.id}`}
					/>
				))
			}
		</div>
	</section>

	<section class="bg-script-accent px-6 py-20 text-center md:px-10">
		<p class="font-script text-3xl text-ink md:text-4xl">Erzählen wir</p>
		<p class="font-display text-4xl uppercase tracking-tight text-ink md:text-6xl">
			und deine <MarkedWord>Marke</MarkedWord>?
		</p>
		<a
			href="/kontakt"
			class="mt-8 inline-block bg-accent px-8 py-4 font-sans text-sm uppercase tracking-widest text-white transition hover:bg-accent-hover"
		>
			Projekt anfragen
		</a>
	</section>
</BaseLayout>
