---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroLogo from "../components/HeroLogo.vue";
import ScrollProgress from "../components/ScrollProgress.vue";
import LogoMarquee from "../components/LogoMarquee.astro";
import { kundenLogos, senderLogos } from "../data/logos";
import { getCollection, type CollectionEntry } from "astro:content";
import { getPosterUrl } from "../lib/video";
import { byNewestFirst } from "../lib/projects";
import { Image, getImage } from "astro:assets";
import WieWasSections from "../components/WieWasSections.vue";
import MarkedWord from "../components/MarkedWord.astro";
import Testimonials from "../components/Testimonials.astro";
import { categoryContent } from "../data/categories";
import kapitelDenken from "../assets/photos/home-kapitel-denken.jpg";
import kapitelHoeren from "../assets/photos/home-kapitel-hoeren.jpg";
import kapitelSehen from "../assets/photos/home-kapitel-sehen.jpg";
import kapitelErzaehlen from "../assets/photos/home-kapitel-erzaehlen.jpg";
import werPortrait from "../assets/photos/kontakt-hero.jpg";

const progressSections = [
	{ id: "hero", label: "Intro" },
	{ id: "wie", label: "Wie" },
	{ id: "was", label: "Was" },
	{ id: "wer", label: "Wer" },
];

const projects = await getCollection("projects");
const showreel = projects.find((p) => p.data.title === "Showreel");
// Standbild als Fallback, sofern kein selbst gehosteter bgClip existiert:
// siehe .poster-cover in global.css für die Begründung (YouTube zeigt sein
// natives Play/Pause-UI, sobald Autoplay fehlschlägt – nicht zuverlässig
// von der Seite aus entfernbar; bei bgClip besteht dieses Risiko nicht).
const showreelPosterUrl = showreel ? await getPosterUrl(showreel.data) : undefined;
const showreelBgClipUrl = showreel?.data.bgClip;

const kapitel = [
	{
		number: "01",
		tagline: "Recherche",
		word: "DENKEN",
		text: "Bevor die Kamera läuft, steht die Idee. Ich recherchiere, lese, telefoniere — und baue daraus ein Konzept, das trägt.",
		markWord: "ein Konzept, das trägt",
		image: kapitelDenken,
	},
	{
		number: "02",
		tagline: "Zuhören",
		word: "HÖREN",
		text: "Was der Kunde sagt — und was er eigentlich meint. Das Gespräch entscheidet, welcher Film am Ende entsteht.",
		markWord: "was er eigentlich meint",
		image: kapitelHoeren,
	},
	{
		number: "03",
		tagline: "Momente",
		word: "SEHEN",
		text: "Drehen heißt warten können. Ich fange die Momente ein, die sich nicht wiederholen lassen — Licht, Blick, Handgriff.",
		markWord: "warten können",
		image: kapitelSehen,
	},
	{
		number: "04",
		tagline: "Schnitt",
		word: "ERZÄHLEN",
		text: "Aus Material wird ein Film: Struktur, Text, Ton, Rhythmus. Dann Feedback — und der letzte Schnitt.",
		markWord: "der letzte Schnitt",
		image: kapitelErzaehlen,
	},
];

const arbeitsweiseSteps = await Promise.all(
	kapitel.map(async (k) => {
		const optimized = await getImage({ src: k.image, widths: [800, 1200], format: "webp" });
		return {
			number: k.number,
			tagline: k.tagline,
			word: [k.word],
			text: k.text,
			markWord: k.markWord,
			image: optimized.src,
			imageAlt: `${k.tagline} – ${k.word}`,
		};
	}),
);

const featuredByCategory = Object.fromEntries(
	categoryContent.map((c) => {
		const inCategory = projects
			.filter(
				(p: CollectionEntry<"projects">) => p.data.category === c.contentCategory,
			)
			.sort(byNewestFirst);
		const featured =
			inCategory.find((p: CollectionEntry<"projects">) => p.data.featured) ??
			inCategory[0];
		return [c.slug, featured];
	}),
);

const wasSteps = await Promise.all(
	categoryContent.map(async (c, i) => {
		const featured = featuredByCategory[c.slug];
		return {
			number: String(i + 1).padStart(2, "0"),
			tagline: c.scriptLine,
			scriptFont: c.scriptFont,
			word: c.headline,
			headlineFont: c.headlineFont,
			posterUrl: featured ? await getPosterUrl(featured.data) : undefined,
			bgClipUrl: featured?.data.bgClip,
			accent: c.accent,
			href: `/${c.slug}`,
			linkLabel: "mehr erfahren",
		};
	}),
);
---

<BaseLayout
	title="Home"
	description="TRUE FRAME – Produktionsfirma für Imagefilme, Magazin & News und Dokumentationen."
	theme="landing"
	showHeaderLogo={false}
>
	<section
		id="hero"
		class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center"
	>
		<div class="absolute inset-0 -z-10 bg-bg">
			{
				showreelBgClipUrl ? (
					<video
						src={showreelBgClipUrl}
						poster={showreelPosterUrl}
						class="poster-cover"
						autoplay
						muted
						loop
						playsinline
					/>
				) : (
					showreelPosterUrl && (
						<img src={showreelPosterUrl} alt="" aria-hidden="true" class="poster-cover" />
					)
				)
			}
			<div class="absolute inset-0 bg-black/70" />
		</div>

		<div class="flex flex-col items-center gap-[clamp(1rem,4vmin,2.5rem)]">
			<HeroLogo client:load />

			<div data-hero-reveal class="flex flex-col items-center gap-4 text-center">
				<p class="font-script text-[clamp(1.25rem,3.5vmin,1.875rem)] text-accent">
					Filme, die bleiben
				</p>
				<h1 class="font-display text-[clamp(2rem,7vmin,6rem)] uppercase leading-[0.85] tracking-tight text-white">
					Ich erzähle<br />deine<br />
					<MarkedWord>Geschichte</MarkedWord>
				</h1>
				<p class="max-w-xl font-sans text-[clamp(0.875rem,2vmin,1.125rem)] text-white/70">
					Produktionsfirma für Imagefilme, Magazin & News und
					Dokumentationen – ehrliche Geschichten, cinematisch erzählt.
				</p>
				<p class="mt-2 font-mono text-[10px] tracking-[0.24em] text-white/50">SCROLLEN</p>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-24 md:px-10">
		<div class="flex items-baseline gap-4">
			<p class="font-mono text-[10px] tracking-[0.26em] text-ink-muted">VERTRAUEN</p>
			<div class="h-px flex-1 bg-line"></div>
			<p class="font-script text-2xl text-accent">gemeinsam entstanden</p>
		</div>

		<div class="mt-12 flex flex-col gap-14">
			<LogoMarquee heading="Kunden" logos={kundenLogos} direction="left" />
			<LogoMarquee heading="Ausgestrahlt bei" logos={senderLogos} direction="right" />
		</div>

		<p class="mt-8 max-w-2xl font-sans text-xs text-ink-muted">
			Hinweis: Ein Teil der gezeigten Sender-Logos steht für vollständige
			Geschichten, die ich selbst produziert habe – ein anderer Teil für
			Rohmaterial, das ich vor Ort gedreht und über Presseagenturen (dpa,
			APA) an die jeweilige Redaktion geliefert habe.
		</p>
	</section>

	<Testimonials />

	<WieWasSections wieSteps={arbeitsweiseSteps} wasSteps={wasSteps} client:load />

	<section id="wer" class="mx-auto max-w-6xl px-6 py-24 md:px-10">
		<div class="flex items-baseline gap-4">
			<p class="font-mono text-[10px] tracking-[0.26em] text-ink-muted">WER</p>
			<div class="h-px flex-1 bg-line"></div>
			<p class="font-script text-2xl text-accent">reden wir</p>
		</div>

		<div class="mt-12 grid items-center gap-12 md:grid-cols-2">
			<div class="aspect-[3/4] overflow-hidden border border-line">
				<Image
					src={werPortrait}
					alt="Gabriel Neumayr"
					class="h-full w-full object-cover"
					widths={[400, 800, 1200]}
					sizes="(min-width: 768px) 50vw, 100vw"
				/>
			</div>
			<div>
				<p class="font-display text-4xl uppercase tracking-tight text-ink md:text-5xl">
					Gabriel Neumayr
				</p>
				<p class="mt-2 font-mono text-xs tracking-widest text-ink-muted">
					VIDEOJOURNALIST &amp; FILMEMACHER · SALZBURG · ÖSTERREICH
				</p>
				<p class="mt-6 max-w-lg font-sans text-ink-muted md:text-lg">
					Mit meinen Produktionen gehe ich oft andere Wege, generell gehe
					ich die extra Meile, um das Produkt zu verbessern. Ich will im
					Endeffekt mit jedem Projekt einen Film mit <MarkedWord>Substanz</MarkedWord> kreieren –
					egal ob Magazinbeitrag für Regionalsender oder Werbefilm für
					Industriekunden. Zukünftig möchte ich hier kreative Ansätze
					verfolgen. Einen „Standardbeitrag“ gibt es bei mir nicht, dafür
					Videos, die in Erinnerung bleiben. Wenn du zu diesem Ansatz
					passt, schreib mir und wir erzählen deine Geschichte!
				</p>
				<a
					href="/kontakt"
					class="mt-8 inline-block bg-accent px-8 py-4 font-sans text-sm uppercase tracking-widest text-white transition hover:bg-accent-hover"
				>
					Kontakt aufnehmen
				</a>
			</div>
		</div>
	</section>

	<ScrollProgress sections={progressSections} client:load />
</BaseLayout>
