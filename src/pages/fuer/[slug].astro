---
// Persönlicher Portfolio-Brief. Eine Seite je Eintrag in src/data/briefe.ts.
//
// Die Seiten entstehen statisch beim Build. Ein Slug, zu dem es keinen Eintrag
// gibt, erzeugt also gar keine Datei – der Aufruf endet in der normalen
// 404-Antwort des Hosters, ohne Hinweis darauf, dass es diese Funktion gibt.

import { getCollection, type CollectionEntry } from "astro:content";
import BriefLayout from "../../layouts/BriefLayout.astro";
import Vorspann from "../../components/brief/Vorspann.astro";
import Brieftext from "../../components/brief/Brieftext.astro";
import Brieffilm from "../../components/brief/Brieffilm.astro";
import Signatur from "../../components/brief/Signatur.astro";
import { briefe, type Brief } from "../../data/briefe";
import { BRIEF_TEXTE, KONTAKT } from "../../data/brief-texte";
import {
	anredeZeile,
	briefAbsaetze,
	mailBetreff,
	ogTitel,
	ortUndDatum,
	vorspannTitel,
	waehleProjekte,
} from "../../lib/brief";
import { getCardEmbedUrl, getPosterUrl } from "../../lib/video";

export async function getStaticPaths() {
	return briefe.map((brief) => ({
		params: { slug: brief.slug },
		props: { brief },
	}));
}

const { brief } = Astro.props as { brief: Brief };

const projekte = await getCollection("projects");
const auswahl = waehleProjekte(brief, projekte);

const filme = await Promise.all(
	auswahl.map(async ({ projekt, notiz }) => {
		const p = projekt as CollectionEntry<"projects">;
		return {
			id: p.id,
			titel: p.data.title,
			meta: [p.data.client, p.data.year].filter(Boolean).join(" · "),
			posterUrl: await getPosterUrl(p.data),
			embedUrl: getCardEmbedUrl(p.data.videoUrl, p.data.startSeconds),
			embeddable: p.data.embeddable,
			videoUrl: p.data.videoUrl,
			notiz,
		};
	}),
);

const titel = ogTitel(brief);
const beschreibung = BRIEF_TEXTE.ogBeschreibung[brief.anrede];

// Vorschaubild der Link-Vorschau: das Standbild des ersten ausgewählten
// Projekts. Lokale Pfade werden absolut gemacht, fremde URLs sind es bereits.
const erstesBild = filme[0]?.posterUrl;
const ogBild = erstesBild
	? erstesBild.startsWith("/")
		? new URL(erstesBild, Astro.site).href
		: erstesBild
	: undefined;

const absaetze = briefAbsaetze(brief);

const cta = brief.cta ?? {
	label: BRIEF_TEXTE.ctaLabel[brief.anrede],
	href: `mailto:${KONTAKT.email}?subject=${encodeURIComponent(mailBetreff(brief))}`,
};

const ps = brief.ps ?? BRIEF_TEXTE.ps[brief.anrede];
---

<BriefLayout titel={titel} beschreibung={beschreibung} ogBild={ogBild}>
	<Vorspann titel={vorspannTitel(brief)} ortDatum={ortUndDatum(new Date())} />

	<Brieftext anrede={anredeZeile(brief)} absaetze={absaetze} />

	<section class="mx-auto max-w-3xl px-6 pb-24 md:pb-32">
		<h2
			class="font-display text-2xl uppercase leading-tight tracking-tight text-ink md:text-4xl"
			data-brief-reveal
		>
			{BRIEF_TEXTE.filmeUeberschrift[brief.anrede]}
		</h2>

		<div class="mt-12 flex flex-col gap-16 md:gap-20">
			{filme.map((film) => <Brieffilm {...film} />)}
		</div>
	</section>

	<section class="mx-auto max-w-[62ch] px-6 pb-24 md:pb-32">
		<p
			data-brief-reveal
			class="font-sans text-lg leading-[1.7] text-ink md:text-xl md:leading-[1.75]"
		>
			{BRIEF_TEXTE.schluss[brief.anrede]}
		</p>

		<div data-brief-reveal class="mt-12">
			<p class="font-sans text-base text-ink-muted md:text-lg">{BRIEF_TEXTE.gruss}</p>
			<div class="mt-2">
				<Signatur />
			</div>
		</div>

		<p data-brief-reveal class="mt-12 font-sans text-sm italic text-ink-muted md:text-base">
			{ps}
		</p>

		<div data-brief-reveal class="mt-14">
			<a
				href={cta.href}
				class="inline-block bg-accent px-8 py-4 font-sans text-sm uppercase tracking-widest text-white transition hover:bg-accent-hover"
			>
				{cta.label}
			</a>
			<p class="mt-5 font-sans text-sm text-ink-muted">
				Oder direkt anrufen:{" "}
				<a
					href={`tel:${KONTAKT.telefonRoh}`}
					class="underline underline-offset-4 transition hover:text-accent"
				>
					{KONTAKT.telefon}
				</a>
			</p>
		</div>
	</section>
</BriefLayout>
