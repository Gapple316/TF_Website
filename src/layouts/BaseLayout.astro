---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	theme: "landing" | "doku" | "imagefilm" | "news";
	showHeaderLogo?: boolean;
}

const { title, description, theme, showHeaderLogo = true } = Astro.props;
---

<!doctype html>
<html lang="de" data-theme={theme}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<title>{title} · TRUE FRAME</title>
		<ClientRouter />
	</head>
	<body class="min-h-screen">
		<div class="grain-overlay pointer-events-none fixed inset-0 z-[70] opacity-[0.05]"></div>
		<Header showLogo={showHeaderLogo} />
		<main>
			<slot />
		</main>
		<Footer />
		<script>
			import "../lib/hero-reveal";
		</script>
	</body>
</html>
