---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	theme: "landing" | "doku" | "imagefilm" | "news";
	showHeaderLogo?: boolean;
	footerVariant?: "full" | "category" | "minimal";
}

const { title, description, theme, showHeaderLogo = true, footerVariant = "full" } = Astro.props;
---

<!doctype html>
<html lang="de" data-theme={theme}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* Eigenes Zeichen statt des Astro-Logos: "TF" in Anton, der Schrift
		    des Logos, darunter das Rot der Marke. ?v=2 hängt dran, weil
		    Browser ein einmal geholtes Favicon sehr lange behalten.

		    Die .ico steht zuerst für alte Browser, die kein SVG verstehen;
		    alle anderen nehmen das SVG und zeichnen es scharf in jeder Größe. */}
		<link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="description" content={description} />
		<title>{title} · TRUE FRAME</title>
		<ClientRouter />
	</head>
	<body class="min-h-screen">
		<div class="grain-overlay pointer-events-none fixed inset-0 z-[70] opacity-[0.05]"></div>
		<Header showLogo={showHeaderLogo} />
		<main>
			<slot />
		</main>
		<Footer variant={footerVariant} />
		<script>
			import "../lib/hero-reveal";
			import "../lib/header-contrast";
			import "../lib/bg-video";
			import "../lib/mark-reveal";
		</script>
	</body>
</html>
