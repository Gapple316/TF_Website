---
import { ClientRouter } from "astro:transitions";
import { BRIEF_TEXTE } from "../data/brief-texte";
import "../styles/global.css";

interface Props {
	/** Persönlicher Titel, z.B. "Ein paar Filme für Maria". */
	titel: string;
	beschreibung: string;
	/** Absolute URL des Vorschaubilds für die Link-Vorschau. */
	ogBild?: string;
}

const { titel, beschreibung, ogBild } = Astro.props;

const seitenUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="de" data-theme="landing">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		{/*
		  Der wichtigste Schutz: Briefe gehören in keinen Suchindex. Wirkt
		  unabhängig von robots.txt und auch dann, wenn jemand den Link
		  weiterleitet.
		*/}
		<meta name="robots" content="noindex, nofollow" />

		<meta name="description" content={beschreibung} />
		<title>{titel}</title>

		{/*
		  Link-Vorschau in Mail und WhatsApp. og:image muss absolut sein,
		  relative Pfade bleiben dort leer – deshalb site in astro.config.mjs.
		*/}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={titel} />
		<meta property="og:description" content={beschreibung} />
		<meta property="og:url" content={seitenUrl} />
		{ogBild && <meta property="og:image" content={ogBild} />}
		<meta name="twitter:card" content={ogBild ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={titel} />
		<meta name="twitter:description" content={beschreibung} />
		{ogBild && <meta name="twitter:image" content={ogBild} />}

		{/*
		  ClientRouter liefert das astro:page-load-Ereignis, auf dem
		  video-player.ts und brief-reveal.ts aufsetzen – dieselbe Mechanik
		  wie auf allen anderen Seiten.
		*/}
		<ClientRouter />

		{/*
		  Sicherung gegen einen leeren Brief: Die Absätze sind nur dann
		  unsichtbar vorbereitet, wenn dieses Skript gelaufen ist – ohne
		  JavaScript steht der Brief also ganz normal da. Läuft das Skript,
		  aber brief-reveal.ts nicht (Ladefehler, blockiertes Bundle), hebt
		  der Zeitgeber die Vorbereitung nach vier Sekunden wieder auf.
		  Inline und im Kopf, damit nichts erst sichtbar ist und dann
		  verschwindet.
		*/}
		<script is:inline>
			document.documentElement.dataset.briefAnimiert = "";
			setTimeout(function () {
				if (document.documentElement.dataset.briefModul !== "aktiv") {
					delete document.documentElement.dataset.briefAnimiert;
				}
			}, 4000);
		</script>
	</head>

	<body class="min-h-screen">
		<div class="grain-overlay pointer-events-none fixed inset-0 z-[70] opacity-[0.05]"></div>

		{/* Bewusst ohne Kopfzeile und ohne Navigation: Der Brief soll ein
		    geschlossenes Stück sein, aus dem man sich nicht versehentlich
		    wegklickt. Der Weg zur Website steht unten im Abspann. */}
		<main>
			<slot />
		</main>

		<footer class="px-6 pb-16 pt-8 md:px-10">
			<div class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
				<img
					src="/images/logos/true-frame-logo.webp"
					alt="TRUE FRAME"
					width="112"
					height="28"
					class="h-7 w-auto opacity-70"
				/>
				<p class="font-mono text-[10px] tracking-[0.24em] text-ink-muted">
					{BRIEF_TEXTE.abspann}
				</p>
				<a
					href="/"
					class="font-sans text-xs text-ink-muted underline underline-offset-4 transition hover:text-accent"
				>
					true-frame.net
				</a>
			</div>
		</footer>

		<script>
			import "../lib/video-player";
			import "../lib/brief-reveal";
		</script>
	</body>
</html>
