---
// Der Brieftext: schmale Spalte, viel Luft, ein Absatz nach dem anderen.
//
// Statt Nummern trägt jeder Absatz eine Zeitmarke (00:00:04, 00:00:12 …) –
// die kleine Film-Anspielung aus der Vorgabe. Die Marken kommen aus
// timecode() in src/lib/brief.ts, sind also für jeden Brief gleich und
// unabhängig von der Textlänge.
//
// Die Anrede steht bewusst in der Lauftext-Schrift und nicht in Anton:
// Ein Brief beginnt leise. Der typografische Auftritt war der Vorspann.

import { timecode } from "../../lib/brief";

interface Props {
	anrede: string;
	absaetze: string[];
}

const { anrede, absaetze } = Astro.props;
---

<section class="mx-auto max-w-[62ch] px-6 py-24 md:py-32">
	<p data-brief-reveal class="font-sans text-xl text-ink md:text-2xl">
		{anrede}
	</p>

	<div class="mt-12 flex flex-col gap-12 md:gap-16">
		{
			absaetze.map((absatz, i) => (
				<div data-brief-reveal>
					<p class="font-mono text-[10px] tracking-[0.26em] text-ink-muted">
						{timecode(i)}
					</p>
					<p class="mt-3 font-sans text-lg leading-[1.7] text-ink md:text-xl md:leading-[1.75]">
						{absatz}
					</p>
				</div>
			))
		}
	</div>
</section>
