---
// Unterschrift unter dem Brief.
//
// Zwischenlösung bis Gabriels echte Unterschrift als SVG-Pfad vorliegt: Der
// Name steht in der Zierschrift und wird von links nach rechts freigelegt
// (clip-path in global.css), was dem Schreiben nahekommt. Sobald der Pfad da
// ist, wird dieses <p> durch ein <svg> mit stroke-dashoffset ersetzt – die
// umgebende Struktur und die data-brief-reveal-Mechanik bleiben gleich.

interface Props {
	name?: string;
}

const { name = "Gabriel" } = Astro.props;
---

<p
	data-brief-reveal
	class="brief-signatur font-script text-5xl text-accent md:text-6xl"
	aria-label={`Unterschrift: ${name}`}
>
	{name}
</p>
