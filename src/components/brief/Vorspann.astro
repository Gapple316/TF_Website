---
// Vorspann des Briefs: schwarze Fläche, aus der zwei Cinemascope-Balken das
// Bildfenster freigeben. Die Titelkarte blendet danach auf – das ist die
// reduzierte Fassung der Logo-Animation von der Startseite (nur Phase 1,
// reines Aufblenden; die FLIP-Bewegung von HeroLogo.vue braucht eine
// Kopfzeile zum Andocken, die es hier nicht gibt).
//
// Die Bewegung steckt in global.css (.brief-balken, .brief-titelkarte) und
// schaltet sich bei prefers-reduced-motion ab.

interface Props {
	titel: string;
	ortDatum: string;
}

const { titel, ortDatum } = Astro.props;
---

<section
	data-brief-vorspann
	class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden bg-black px-6 text-center"
>
	<div class="brief-balken brief-balken--oben" aria-hidden="true"></div>
	<div class="brief-balken brief-balken--unten" aria-hidden="true"></div>

	<div class="brief-titelkarte relative z-10 flex flex-col items-center gap-6">
		<img
			src="/images/logos/true-frame-logo.webp"
			alt="TRUE FRAME"
			width="176"
			height="44"
			class="h-9 w-auto opacity-80 md:h-11"
		/>

		<h1
			class="font-display text-[clamp(2.25rem,8vmin,5rem)] uppercase leading-[0.9] tracking-tight text-white"
		>
			{titel}
		</h1>

		<p class="font-mono text-[10px] tracking-[0.26em] text-white/50 md:text-xs">
			{ortDatum}
		</p>
	</div>

	<p
		class="brief-scrollhinweis absolute bottom-[13vh] left-1/2 z-10 -translate-x-1/2 font-mono text-[10px] tracking-[0.24em] text-white/40"
	>
		SCROLLEN
	</p>
</section>
