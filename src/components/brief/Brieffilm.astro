---
// Ein Film im Brief – im Zuschnitt der "WAS"-Panels von der Startseite
// (WieWasSections.vue): vollflächiges Standbild, dunkler Verlauf darüber,
// Nummer, Titel und Meta unten links. Dadurch liest sich die Filmstrecke
// wie der Rest der Website und nicht wie eine Kartenliste.
//
// Technisch bleibt es beim bewährten Muster der Projektseiten: Das Video
// lädt erst beim Klick und geht dann in den echten Browser-Fullscreen.
// Beim Öffnen des Briefs wird also kein einziges Video geladen.
//
// Der Knopf liegt als unsichtbare Fläche über dem ganzen Panel, der
// Textblock darüber ist klickdurchlässig. Grund: Ein <button> darf laut
// HTML keine Überschrift enthalten – Titel und Knopf müssen deshalb
// Geschwister sein, nicht verschachtelt.

interface Props {
	id: string;
	/** Laufende Nummer im Brief, z.B. "01". */
	nummer: string;
	titel: string;
	meta?: string;
	posterUrl?: string;
	/** Fehlt, wenn das Video (noch) nicht eingebettet werden kann. */
	embedUrl?: string;
	/** false = Einbettung vom Rechteinhaber gesperrt, dann Link zur Plattform. */
	embeddable?: boolean;
	videoUrl?: string;
	notiz?: string;
}

const { id, nummer, titel, meta, posterUrl, embedUrl, embeddable, videoUrl, notiz } =
	Astro.props;

const gesperrt = embeddable === false && !!videoUrl;
const abspielbar = !!embedUrl && !gesperrt;
---

<article data-brief-reveal>
	<div class="relative h-[68svh] w-full overflow-hidden md:h-[80svh]">
		{
			posterUrl && (
				<img src={posterUrl} alt="" aria-hidden="true" loading="lazy" class="poster-cover" />
			)
		}
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/70"></div>

		{
			gesperrt ? (
				<a
					href={videoUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="group absolute inset-0 z-10 flex items-center justify-center"
					aria-label={`${titel} auf der Original-Plattform ansehen (externer Link)`}
				>
					<span class="flex h-16 w-16 items-center justify-center rounded-full bg-accent/90 text-white transition group-hover:bg-accent md:h-20 md:w-20">
						<svg viewBox="0 0 24 24" class="h-6 w-6 fill-current md:h-8 md:w-8">
							<path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z" />
							<path d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7z" />
						</svg>
					</span>
				</a>
			) : abspielbar ? (
				<button
					type="button"
					data-video-play={id}
					class="group absolute inset-0 z-10 flex w-full items-center justify-center"
					aria-label={`${titel} abspielen`}
				>
					<span class="flex h-16 w-16 items-center justify-center rounded-full bg-accent/90 text-white transition group-hover:scale-105 group-hover:bg-accent md:h-20 md:w-20">
						<svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 fill-current md:h-8 md:w-8">
							<path d="M8 5v14l11-7z" />
						</svg>
					</span>
				</button>
			) : (
				<div class="absolute inset-0 z-10 flex items-center justify-center">
					<span class="font-script text-3xl text-accent">Video folgt</span>
				</div>
			)
		}

		<div
			class="pointer-events-none absolute inset-x-0 bottom-0 z-20 flex flex-col gap-3 px-6 pb-12 md:px-10 md:pb-16"
		>
			<p class="font-mono text-xs tracking-[0.3em] text-white/50">{nummer}_</p>
			<h3
				class="font-display text-4xl uppercase leading-[0.85] tracking-tight text-white md:text-7xl"
			>
				{titel}
			</h3>
			{meta && <p class="font-mono text-xs tracking-widest text-white/70">{meta}</p>}
			{
				abspielbar && (
					<p class="mt-1 font-mono text-xs uppercase tracking-widest text-white/80">
						[ Film ansehen ]
					</p>
				)
			}
		</div>

		{
			abspielbar && (
				<iframe
					data-video-frame={id}
					data-src={embedUrl}
					class="hidden absolute inset-0 z-30 h-full w-full"
					title={titel}
					allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen"
					allowfullscreen
				/>
			)
		}
	</div>

	{
		notiz && (
			<div class="mx-auto max-w-[62ch] px-6 pt-6">
				<p class="border-l-2 border-accent/40 pl-4 font-sans text-base italic leading-relaxed text-ink-muted md:text-lg">
					{notiz}
				</p>
			</div>
		)
	}
</article>
