---
import type { LogoEntry } from "../data/logos";

interface Props {
	heading: string;
	logos: LogoEntry[];
	direction?: "left" | "right";
}

const { heading, logos, direction = "left" } = Astro.props;

// Der Loop funktioniert nur nahtlos, wenn EINE Gruppe schon breiter ist als
// der Viewport – sonst sieht man die Lücke/den Sprung, bevor die zweite
// Gruppe nachrückt (genau das Problem bei "Kunden" mit nur 3 Logos vs.
// "Ausgestrahlt bei" mit 6). Deshalb wird der Logo-Satz je Gruppe so oft
// wiederholt, bis mindestens 8 Logos drin sind – unabhängig davon, wie
// wenige echte Logos es aktuell gibt.
const repeatCount = Math.max(1, Math.ceil(8 / logos.length));
const repeatedLogos = Array.from({ length: repeatCount }, () => logos).flat();
---

<div class="w-full">
	<p class="font-mono text-[10px] tracking-[0.26em] text-ink-muted">{heading}</p>
	<div class="logo-marquee relative mt-6 overflow-hidden">
		<div
			class="logo-marquee__track"
			class:list={[direction === "right" && "logo-marquee__track--reverse"]}
		>
			<div class="logo-marquee__group">
				{
					/* Ohne hinterlegte URL kein <a>: ein Anker ohne href ist kein
					   Link, nicht fokussierbar und verwirrt Screenreader nur. */
					repeatedLogos.map((logo) =>
						logo.url ? (
							<a href={logo.url} target="_blank" rel="noopener noreferrer" class="shrink-0">
								<img src={logo.src} alt={logo.name} class="logo-marquee__logo" />
							</a>
						) : (
							<img src={logo.src} alt={logo.name} class="logo-marquee__logo shrink-0" />
						),
					)
				}
			</div>
			<div class="logo-marquee__group" aria-hidden="true">
				{
					repeatedLogos.map((logo) => (
						<img src={logo.src} alt="" class="logo-marquee__logo shrink-0" />
					))
				}
			</div>
		</div>
	</div>
</div>
