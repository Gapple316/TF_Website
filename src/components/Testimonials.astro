---
import { testimonials } from "../data/testimonials";
import MarkedWord from "./MarkedWord.astro";
---

<section class="mx-auto max-w-6xl px-6 pb-24 md:px-10">
	<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<p class="font-mono text-[10px] tracking-[0.26em] text-ink-muted">STIMMEN</p>
		<div class="h-px min-w-6 flex-1 bg-line"></div>
		<h2 class="font-script text-2xl text-accent">was Kunden sagen</h2>
	</div>

	<div class="mt-12 flex flex-col gap-px bg-line">
		{
			testimonials.map((person) => (
				<figure class="bg-bg py-10 md:py-12">
					<div class="grid gap-6 md:grid-cols-[auto_1fr] md:gap-10">
						<div class="flex items-center gap-4 md:block">
							{person.image ? (
								<img
									src={person.image}
									alt={person.imageAlt ?? person.name}
									loading="lazy"
									width="112"
									height="112"
									class="h-16 w-16 shrink-0 border border-line object-cover md:h-28 md:w-28"
								/>
							) : (
								<div class="flex h-16 w-16 shrink-0 items-center justify-center border border-line md:h-28 md:w-28">
									<span class="font-script text-3xl text-accent md:text-5xl">
										{person.name.charAt(0)}
									</span>
								</div>
							)}

							{/* Auf Mobil steht die Zuordnung neben dem Bild, auf Desktop darunter. */}
							<figcaption class="md:mt-4">
								<p class="font-display text-lg uppercase leading-tight tracking-tight text-ink">
									{person.name}
								</p>
								<p class="mt-1 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-muted md:max-w-44">
									{person.role}
								</p>
							</figcaption>
						</div>

						<blockquote class="font-sans text-ink-muted">
							{person.quote.map((absatz, i) => (
								<p class={i > 0 ? "mt-4" : undefined}>
									{i === 0 && <span class="text-accent">&bdquo;</span>}
									{absatz}
									{i === person.quote.length - 1 && <span class="text-accent">&ldquo;</span>}
								</p>
							))}
						</blockquote>
					</div>
				</figure>
			))
		}
	</div>

	<p class="mt-10 font-sans text-sm text-ink-muted">
		Offenes Feedback ist für mich ein zentraler Teil der Zusammenarbeit &#8201;—&#8201;<MarkedWord variant="underline">auch das kritische</MarkedWord>.
	</p>
</section>
