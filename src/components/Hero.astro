---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getThumbnailUrl } from "../lib/video";

interface Props {
	videoUrl?: string;
	/** Überschreibt das automatisch geholte Plattform-Standbild – nötig für
	 *  Beiträge, die nicht auf YouTube/Vimeo liegen. */
	posterUrlOverride?: string;
	bgClipUrl?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	/** Bildausschnitt für `image`. Nötig, weil der Hero querformatig ist: Ein
	 *  Hochformat-Porträt wird darin stark beschnitten, und mittig zentriert
	 *  fällt der Kopf aus dem Bild. Erwartet einen object-position-Wert. */
	imagePosition?: string;
	caption?: string;
	scriptLine: string;
	scriptFont?: "script" | "news-script";
	headline: string[];
	headlineFont?: "display" | "doku" | "news";
	metaLine?: string;
	body?: string;
}

const {
	videoUrl,
	posterUrlOverride,
	bgClipUrl,
	image,
	imageAlt,
	imagePosition = "center",
	caption,
	scriptLine,
	scriptFont = "script",
	headline,
	headlineFont = "display",
	metaLine,
	body,
} = Astro.props;

// Iframes (YouTube/Vimeo) scheiden als Ambient-Hintergrund aus: YouTube
// zeigt sein natives Play/Pause-UI, sobald Autoplay im jeweiligen
// Browser/Kontext fehlschlägt – reproduzierbar, nicht nur ein seltener
// Rand­fall, und von der einbettenden Seite aus nicht entfernbar (fremde
// Origin). Bei bgClip (selbst gehosteter, komprimierter Kurzclip) besteht
// dieses Risiko nicht: same-origin <video autoplay muted loop>, kein
// fremdes UI kann je durchscheinen. Ohne bgClip fällt es auf ein
// Standbild (Video-Thumbnail) zurück.
const posterUrl = posterUrlOverride ?? (videoUrl ? await getThumbnailUrl(videoUrl) : undefined);
---

<section id="hero" class="relative flex min-h-screen flex-col overflow-hidden">
	<div class="absolute inset-0 -z-10 bg-bg">
		{
			bgClipUrl ? (
				<video
					src={bgClipUrl}
					poster={posterUrl}
					class="poster-cover"
					autoplay
					muted
					loop
					playsinline
				/>
			) : posterUrl ? (
				<img src={posterUrl} alt="" aria-hidden="true" class="poster-cover" />
			) : image ? (
				<Image
					src={image}
					alt={imageAlt ?? ""}
					class="h-full w-full object-cover"
					style={`object-position: ${imagePosition}`}
					widths={[640, 1024, 1600, 2400]}
					sizes="100vw"
				/>
			) : null
		}
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/70" />
	</div>

	{
		caption && (
			<p class="absolute left-1/2 top-[26%] w-full max-w-[90vw] -translate-x-1/2 -translate-y-1/2 text-center font-mono text-[10px] tracking-[0.2em] text-white/40 md:w-auto md:max-w-none md:whitespace-nowrap md:tracking-[0.3em]">
				{caption}
			</p>
		)
	}

	<div data-hero-reveal class="mt-auto flex flex-col gap-3 px-6 pb-16 pt-32 md:px-10 md:pb-20">
		<p
			class="text-script-accent text-3xl md:text-5xl"
			class:list={[scriptFont === "news-script" ? "font-doku italic font-black" : "font-script"]}
		>
			{scriptLine}
		</p>
		<h1
			class="uppercase leading-[0.85] tracking-tight text-white"
			class:list={[
				headlineFont === "doku" && "font-doku font-black text-5xl md:text-8xl",
				headlineFont === "news" && "font-news font-extralight tracking-normal text-5xl md:text-8xl",
				headlineFont === "display" && "font-display text-5xl md:text-8xl",
			]}
		>
			{headline.map((line, i) => (
				<>
					{i > 0 && <br />}
					{line}
				</>
			))}
		</h1>
		{metaLine && <p class="font-mono text-xs tracking-widest text-white/70">{metaLine}</p>}
		{body && <p class="max-w-xl font-sans text-white/70 md:text-lg">{body}</p>}
	</div>
</section>
