---
// Die Figur von hinten, wie sie im Kinosessel neben dem reservierten Platz
// sitzt. Man sieht nur Hinterkopf und Schultern.
//
// Bewusst inline statt als Datei unter public/: Das SVG ist winzig, erbt so
// die Farben der Seite über currentColor und braucht keine eigene Anfrage.
// Die vier großen Szenen liegen dagegen als austauschbare Dateien unter
// public/screening/cartoon/.
//
// PLATZHALTER: Das ist eine stilistisch passende Figur, keine Ähnlichkeit mit
// Gabriel. Zum Austauschen genügt es, die Pfade hier zu ersetzen – Größe und
// Einbindung bleiben.
---

<svg
	class="kino-figur-sitzend"
	viewBox="0 0 60 54"
	fill="none"
	aria-hidden="true"
	focusable="false"
>
	{/* Schultern */}
	<path
		d="M4 54 C 6 40, 16 34, 30 34 C 44 34, 54 40, 56 54 Z"
		fill="currentColor"
	/>
	{/* Hinterkopf */}
	<path
		d="M30 6 C 40 6, 46 13, 46 22 C 46 30, 39 36, 30 36 C 21 36, 14 30, 14 22 C 14 13, 20 6, 30 6 Z"
		fill="currentColor"
	/>
	{/* Haaransatz: ein paar Strähnen, damit der Kopf nicht wie eine Kugel wirkt */}
	<path
		d="M17 17 C 22 11, 28 9, 34 10 M22 13 C 27 9, 33 8, 38 11 M40 15 C 43 18, 44 21, 44 24"
		stroke="rgba(0,0,0,0.45)"
		stroke-width="1.4"
		stroke-linecap="round"
	/>
	{/* Lichtkante vom Leinwandlicht */}
	<path
		d="M44 18 C 46 22, 46 28, 43 32"
		stroke="rgba(255,235,200,0.5)"
		stroke-width="1.6"
		stroke-linecap="round"
	/>
</svg>
