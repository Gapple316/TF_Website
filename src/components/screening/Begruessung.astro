---
// Zwischenschritt nach dem Abreißen: Gabriel steht groß im Bild und erklärt
// in zwei Sätzen, was gleich passiert.
//
// Grund: Ohne diese Erklärung war unverständlich, warum im Saal jemand neben
// einem sitzt und später klein in der Ecke auftaucht. Jetzt wird man begrüßt
// und ausdrücklich eingeladen, sich danebenzusetzen – ab da ergibt die Figur
// von selbst Sinn.
//
// Es ist ein Foto, keine Zeichnung: Eine gezeichnete Figur blieb immer eine
// Behauptung von Ähnlichkeit. Dasselbe Bild sitzt später klein in der Ecke,
// damit man denselben Menschen wiedererkennt.
//
// Weiter geht es nur über den Knopf, nie von allein.

import { Image } from "astro:assets";
import portrait from "../../assets/photos/gabriel-figur.jpg";
import { BEGRUESSUNG } from "../../data/screening-texte";

interface Props {
	anrede: "du" | "sie";
}

const { anrede } = Astro.props;
---

<section class="kino-begruessung" data-kino-begruessung>
	<div class="kino-begruessung__inner">
		<Image
			src={portrait}
			alt="Gabriel Neumayr"
			widths={[240, 480]}
			sizes="(min-width: 768px) 15rem, 8.5rem"
			class="kino-begruessung__figur"
		/>

		<div class="kino-begruessung__text">
			<p class="kino-begruessung__hallo">{BEGRUESSUNG.hallo[anrede]}</p>
			<p class="kino-begruessung__einladung">{BEGRUESSUNG.einladung[anrede]}</p>
			<button type="button" class="kino-begruessung__knopf" data-begruessung-weiter>
				{BEGRUESSUNG.knopf[anrede]}
			</button>
		</div>
	</div>
</section>
