---
// Szene 6: "Was ich kann". Ersetzt den früheren Credits-Abspann.
//
// Hieß einmal "Meine kleine Vorstellung" – das Wortspiel aus Kinovorstellung
// und Sich-Vorstellen. Das Wort steht aber schon im Ticket, im Vorspann und
// im Schluss; hier heißt der Abschnitt deshalb nach dem, was er zeigt.
//
// Aufbau: Titelkarte, vier Szenen als Filmstreifen, Übergang auf das echte
// Foto, Schluss mit Aufruf und Post-Credits-Szene.
//
// Im Streifen stehen die vier Fotos der Startseite, keine Zeichnungen: Die
// gezeichneten Szenen wirkten neben dem echten Material billig, und es sind
// dieselben vier Kapitel – Denken, Hören, Sehen, Erzählen.
//
// Der Streifen wird nicht mehr festgehalten und waagrecht durchgeschoben: Ein
// gepinnter Abschnitt ließ den Teil darunter darüberlaufen, sodass nichts
// davon zu lesen war. Jetzt ist er ein Kader-Raster, das von allein stehen
// bleibt – vier Bilder in einer Reihe, am Handy untereinander.

import { Image } from "astro:assets";
import kontaktFoto from "../../assets/photos/kontakt-hero.jpg";
import kapitelDenken from "../../assets/photos/home-kapitel-denken.jpg";
import kapitelHoeren from "../../assets/photos/home-kapitel-hoeren.jpg";
import kapitelSehen from "../../assets/photos/home-kapitel-sehen.jpg";
import kapitelErzaehlen from "../../assets/photos/home-kapitel-erzaehlen.jpg";
import {
	AUSRUESTUNG,
	KOENNEN,
	KOENNEN_REIHENFOLGE,
	KONTAKT,
	SCHLUSS,
	SZENEN,
	VORSTELLUNG,
	type Zielgruppe,
} from "../../data/screening-texte";

interface Props {
	anrede: "du" | "sie";
	zielgruppe: Zielgruppe;
	ps: string;
	ctaHref: string;
	/** Kommentar der Figur, kurz bevor dieser Teil beginnt. */
	figurSagt: string;
}

const { anrede, zielgruppe, ps, ctaHref, figurSagt } = Astro.props;

const koennen = KOENNEN_REIHENFOLGE[zielgruppe].map((k) => KOENNEN[k]);

// Die Zuordnung steht hier und nicht in screening-texte.ts: Die Texte sollen
// keine Bild-Importe kennen, sonst lädt jeder, der sie importiert, die Fotos
// mit. Der Schlüssel in SZENEN verbindet beides.
const FOTOS = {
	denken: kapitelDenken,
	hoeren: kapitelHoeren,
	sehen: kapitelSehen,
	erzaehlen: kapitelErzaehlen,
};

const szenen = SZENEN.map((szene) => ({ ...szene, foto: FOTOS[szene.schluessel] }));
---

<section class="kino-vorstellung" data-figur-sagt={figurSagt}>
	{/* 5a – Titelkarte auf der Leinwand */}
	<div class="kino-titelkarte" data-kino-reveal>
		<p class="kino-titelkarte__text">{VORSTELLUNG.titelkarte}</p>
	</div>

	{/* 5b – Vier Kader in einer Reihe */}
	<div class="kino-streifen">
		{
			szenen.map((szene, i) => (
				<figure class="kino-szene" data-kino-reveal>
					<div class="kino-szene__rahmen">
						<p class="kino-szene__nummer">{String(i + 1).padStart(2, "0")}</p>
						<Image
							src={szene.foto}
							alt={szene.alt}
							widths={[320, 640]}
							sizes="(min-width: 1024px) 15rem, (min-width: 768px) 22rem, 90vw"
							loading="lazy"
						/>
					</div>
					<figcaption class="kino-szene__text">
						<span class="kino-szene__titel">{szene.titel}</span>
						{szene.unterschrift}
						{
							szene.schlagworte.length > 0 && (
								<span class="kino-szene__schlagworte">
									{szene.schlagworte.map((w) => (
										<span class="kino-szene__schlagwort">{w}</span>
									))}
								</span>
							)
						}
					</figcaption>
				</figure>
			))
		}
	</div>

	{/* 5c – Das echte Ich */}
	<div class="kino-echt" data-kino-reveal>
		<div class="kino-echt__bild">
			<p class="kino-echt__handschrift">{VORSTELLUNG.echtIch[anrede]}</p>
			<figure class="kino-aushang">
				<Image
					src={kontaktFoto}
					alt="Gabriel Neumayr"
					widths={[400, 800]}
					sizes="(min-width: 768px) 24rem, 70vw"
				/>
				<figcaption>{VORSTELLUNG.bildunterschrift}</figcaption>
			</figure>
		</div>

		<div class="kino-echt__text">
			<p class="kino-echt__statement">{VORSTELLUNG.statement[anrede]}</p>
			<p class="kino-echt__absatz">{VORSTELLUNG.werIchBin[anrede]}</p>

			<p class="kino-echt__koennentitel">{VORSTELLUNG.koennenTitel}</p>
			<ul class="kino-koennen">
				{koennen.map((k) => <li>{k}</li>)}
			</ul>
		</div>
	</div>

	{/* 5c2 – Für alle, die nach der Ausrüstung fragen */}
	<div class="kino-ausruestung" data-kino-reveal>
		<p class="kino-ausruestung__handschrift">{AUSRUESTUNG.handschrift}</p>
		<p class="kino-ausruestung__titel">{AUSRUESTUNG.titel}</p>
		<ul class="kino-ausruestung__liste">
			{AUSRUESTUNG.liste.map((g) => <li>{g}</li>)}
		</ul>
		<p class="kino-ausruestung__nachsatz">{AUSRUESTUNG.nachsatz}</p>
	</div>

	{/* 5d – Schluss */}
	<div class="kino-schluss" data-kino-reveal>
		<p class="kino-schluss__gefallen">{VORSTELLUNG.schluss[anrede]}</p>
		<p class="kino-schluss__satz">{SCHLUSS.cta}</p>
		<a class="kino-schluss__knopf" href={ctaHref}>{SCHLUSS.ctaLabel[anrede]}</a>
		<p class="kino-schluss__telefon">
			Oder direkt anrufen:{" "}
			<a href={`tel:${KONTAKT.telefonRoh}`}>{KONTAKT.telefon}</a>
		</p>
	</div>

	<div class="kino-postcredits" data-kino-reveal>
		<p class="kino-postcredits__marke">{SCHLUSS.postCredits}</p>
		<p class="kino-postcredits__text">{ps}</p>
	</div>

	<a class="kino-website" href="/">true-frame.net</a>
</section>
