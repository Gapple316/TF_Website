---
// Szene 6: "Meine kleine Vorstellung" – das Wortspiel aus Kinovorstellung und
// Sich-Vorstellen. Ersetzt den früheren Credits-Abspann.
//
// Aufbau: Titelkarte, vier Zeichentrickszenen als Filmstreifen, Übergang auf
// das echte Foto, Schluss mit Aufruf und Post-Credits-Szene.
//
// Der Filmstreifen läuft am Rechner waagrecht beim Scrollen durch (Pinning
// über GSAP, dasselbe Muster wie die WIE-Sektion der Startseite) und am Handy
// schlicht untereinander – dort wäre waagrechtes Scrollen eine Zumutung.

import { Image } from "astro:assets";
import kontaktFoto from "../../assets/photos/kontakt-hero.jpg";
import {
	KOENNEN,
	KOENNEN_REIHENFOLGE,
	KONTAKT,
	SCHLUSS,
	SZENEN,
	VORSTELLUNG,
	type Zielgruppe,
} from "../../data/screening-texte";

interface Props {
	anrede: "du" | "sie";
	zielgruppe: Zielgruppe;
	ps: string;
	ctaHref: string;
	/** Kommentar der Figur, kurz bevor dieser Teil beginnt. */
	figurSagt: string;
}

const { anrede, zielgruppe, ps, ctaHref, figurSagt } = Astro.props;

const koennen = KOENNEN_REIHENFOLGE[zielgruppe].map((k) => KOENNEN[k]);
---

<section class="kino-vorstellung" data-figur-sagt={figurSagt}>
	{/* 5a – Titelkarte auf der Leinwand */}
	<div class="kino-titelkarte" data-kino-reveal>
		<p class="kino-titelkarte__text">{VORSTELLUNG.titelkarte}</p>
	</div>

	{/* 5b – Vier Szenen als Filmstreifen */}
	<div class="kino-streifen" data-filmstreifen>
		<div class="kino-streifen__bahn" data-filmstreifen-bahn>
			{
				SZENEN.map((szene, i) => (
					<figure class="kino-szene" data-kino-reveal>
						<div class="kino-szene__rahmen">
							<p class="kino-szene__nummer">{String(i + 1).padStart(2, "0")}</p>
							{/* Bewusst ohne loading="lazy": Am Rechner liegen die Szenen
							    waagrecht nebeneinander außerhalb des Bildes, und der
							    Browser holt verzögerte Bilder dort nicht nach. Es sind
							    fünf kleine SVG-Dateien, das Nachladen spart nichts. */}
							<img src={szene.datei} alt={szene.alt} width="400" height="300" />
						</div>
						<figcaption class="kino-szene__text">
							<span class="kino-szene__titel">{szene.titel}</span>
							{szene.unterschrift}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>

	{/* 5c – Das echte Ich */}
	<div class="kino-echt" data-kino-reveal>
		<div class="kino-echt__bild">
			<p class="kino-echt__handschrift">{VORSTELLUNG.echtIch[anrede]}</p>
			<figure class="kino-aushang">
				<Image
					src={kontaktFoto}
					alt="Gabriel Neumayr"
					widths={[400, 800]}
					sizes="(min-width: 768px) 24rem, 70vw"
				/>
				<figcaption>{VORSTELLUNG.bildunterschrift}</figcaption>
			</figure>
		</div>

		<div class="kino-echt__text">
			<p class="kino-echt__statement">{VORSTELLUNG.statement[anrede]}</p>
			<p class="kino-echt__absatz">{VORSTELLUNG.werIchBin[anrede]}</p>

			<p class="kino-echt__koennentitel">{VORSTELLUNG.koennenTitel}</p>
			<ul class="kino-koennen">
				{koennen.map((k) => <li>{k}</li>)}
			</ul>
		</div>
	</div>

	{/* 5d – Schluss */}
	<div class="kino-schluss" data-kino-reveal>
		<p class="kino-schluss__gefallen">{VORSTELLUNG.schluss[anrede]}</p>
		<p class="kino-schluss__satz">{SCHLUSS.cta}</p>
		<a class="kino-schluss__knopf" href={ctaHref}>{SCHLUSS.ctaLabel[anrede]}</a>
		<p class="kino-schluss__telefon">
			Oder direkt anrufen:{" "}
			<a href={`tel:${KONTAKT.telefonRoh}`}>{KONTAKT.telefon}</a>
		</p>
	</div>

	<div class="kino-postcredits" data-kino-reveal>
		<p class="kino-postcredits__marke">{SCHLUSS.postCredits}</p>
		<p class="kino-postcredits__text">{ps}</p>
	</div>

	<a class="kino-website" href="/">true-frame.net</a>
</section>
