---
// Szene 5: Ein Block, der sich nach der Zielgruppe richtet.
//
// Sender und Werbekunden bekommen die bestehenden Logo-Slider der Startseite
// (LogoMarquee mit senderLogos bzw. kundenLogos), kein neues Bauteil und
// keine doppelte Datenpflege.
//
// Produktionsfirmen bekommen hier gar nichts mehr: Der Technik-Kasten stand
// genau das, was die Ausrüstungsliste weiter unten ohnehin aufzählt. Dann
// entfällt der ganze Abschnitt, statt eine leere Hülle stehen zu lassen.

import LogoMarquee from "../LogoMarquee.astro";
import { kundenLogos, senderLogos } from "../../data/logos";
import { ZIELGRUPPEN_BLOCK, type Zielgruppe } from "../../data/screening-texte";

interface Props {
	zielgruppe: Zielgruppe;
}

const { zielgruppe } = Astro.props;
---

{
	zielgruppe !== "produktion" && (
		<section class="kino-zielgruppe" data-kino-reveal>
			{
				zielgruppe === "sender" && (
					<div class="kino-zielgruppe__inner">
						<h2 class="kino-abschnitt__titel">{ZIELGRUPPEN_BLOCK.sender.titel}</h2>
						<p class="kino-zielgruppe__absatz">{ZIELGRUPPEN_BLOCK.sender.absatz}</p>
						<div class="kino-zielgruppe__slider">
							<LogoMarquee heading="Sender" logos={senderLogos} direction="left" />
						</div>
					</div>
				)
			}

			{
				zielgruppe === "werbekunde" && (
					<div class="kino-zielgruppe__inner">
						<h2 class="kino-abschnitt__titel">{ZIELGRUPPEN_BLOCK.werbekunde.titel}</h2>
						<div class="kino-zielgruppe__slider">
							<LogoMarquee heading="Kunden" logos={kundenLogos} direction="left" />
						</div>
					</div>
				)
			}
		</section>
	)
}
