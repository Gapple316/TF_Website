---
// Rote Stift-Markierung um ein Stichwort (Vorbild: handgezeichnet umkreistes
// Wort in einer Headline). Die Pfade sind bewusst unregelmäßig gezeichnet –
// ungleiche Radien, leichte Dellen und ein überstehendes Ende, das sich mit
// dem Anfang kreuzt. Eine mathematisch saubere Ellipse sieht sofort nach
// Vektorgrafik statt nach Stift aus.
//
// Die Strichstärke hängt über em an der Schriftgröße (skaliert also mit),
// bleibt dank non-scaling-stroke aber gleichmäßig – ohne das würde sie durch
// preserveAspectRatio="none" an den Seiten dünner als oben/unten gezogen.

interface Props {
	variant?: "circle" | "underline";
}

const { variant = "circle" } = Astro.props;
---

<span class="marked-word" data-mark={variant}>
	<slot />
	{
		variant === "circle" ? (
			<svg
				class="marked-word__mark"
				viewBox="0 0 320 140"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					class="mark-main"
					d="M40,88 C25,69 23,45 48,31 C73,17 115,8 157,7 C197,6 245,10 278,23 C303,33 317,48 313,65 C309,85 288,102 256,114 C221,127 172,133 130,129 C93,126 53,115 35,96 C24,84 22,70 29,58"
				/>
				<path class="mark-echo" d="M58,30 C92,16 132,10 170,10" />
			</svg>
		) : (
			<svg
				class="marked-word__mark"
				viewBox="0 0 320 40"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					class="mark-main"
					d="M6,25 C40,15 78,9 124,8 C170,7 226,13 278,22 C292,24 303,27 314,31"
				/>
				<path class="mark-echo" d="M30,33 C78,25 140,22 196,25" />
			</svg>
		)
	}
</span>
