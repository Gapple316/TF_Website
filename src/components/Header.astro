---
import MobileNav from "./MobileNav.vue";

interface Props {
	showLogo?: boolean;
}

const { showLogo = true } = Astro.props;

const links = [
	{ href: "/", label: "Start" },
	{ href: "/imagefilme", label: "Imagefilme" },
	{ href: "/dokumentationen", label: "Dokumentationen" },
	{ href: "/nachrichten", label: "Nachrichten" },
	{ href: "/kontakt", label: "Kontakt" },
];

const currentPath = Astro.url.pathname;
---

<header
	data-hero-reveal
	class="fixed inset-x-0 top-0 z-30 flex items-center justify-between px-6 py-5 md:px-10"
>
	<a href="/" class="relative z-50" class:list={[{ invisible: !showLogo }]}>
		<img
			src="/images/logos/true-frame-logo.webp"
			alt="TRUE FRAME — by Gabriel Neumayr"
			class="h-[38px] w-auto md:h-[52px]"
		/>
	</a>

	<nav class="hidden items-center gap-10 md:flex lg:gap-12">
		{
			links.map((link) => {
				const active = currentPath === link.href;
				return (
					<a
						href={link.href}
						class="nav-link font-sans text-[11px] uppercase tracking-[0.12em]"
						data-active={active ? "true" : "false"}
					>
						{link.label}
					</a>
				);
			})
		}
	</nav>

	<MobileNav links={links} client:load />
</header>
